{
	"name": "@bastani/atomic-gui",
	"version": "0.0.0",
	"private": true,
	"description": "Electron desktop GUI host for Atomic, speaking the interactive-engine protocol.",
	"type": "module",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "npm run build && vitest --run --config vitest.config.ts",
		"pack": "npm run build && electron-builder --dir && node scripts/packaged-smoke.mjs",
		"pack:directory": "npm run pack",
		"dist": "npm run build && electron-builder"
	},
	"dependencies": {
		"@codemirror/commands": "6.10.4",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/state": "6.7.1",
		"@codemirror/view": "6.43.8",
		"dompurify": "3.4.13",
		"marked": "18.0.9",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"zustand": "5.0.14"
	},
	"devDependencies": {
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react": "4.7.0",
		"electron": "43.3.0",
		"electron-builder": "26.15.3",
		"electron-vite": "5.0.0",
		"jsdom": "30.0.1",
		"playwright": "1.58.2",
		"vite": "7.3.6"
	},
	"build": {
		"appId": "com.bastani.atomic-gui",
		"productName": "Atomic",
		"directories": {
			"output": "release"
		},
		"files": [
			"out/**/*",
			"package.json"
		],
		"linux": {
			"target": [
				"AppImage",
				"dir"
			],
			"category": "Development"
		},
		"mac": {
			"target": [
				"dmg",
				"dir"
			],
			"category": "public.app-category.developer-tools"
		},
		"win": {
			"target": [
				"nsis",
				"dir"
			]
		}
	}
}
